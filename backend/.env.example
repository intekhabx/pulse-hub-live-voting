PORT=5000
MONGODB_URI=mongodb-db-uri


JWT_ACCESS_TOKEN=access_token_string
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_TOKEN=refresh_token_string
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=your-cookie-secret

REDIS_URI=enter-your-redis-url

FRONTEND_BASE_URL=your-frontend-url

NODE_ENV=development


GOOGLE_CLIENT_ID=your-google-client_id
GOOGLE_CLIENT_SECRET=your-google-client_secret
GOOGLE_CALLBACK_URL=your-google-redirect-callback_url

GITHUB_CLIENT_ID=your-google-client_id
GITHUB_CLIENT_SECRET=your-google-client_secret
GITHUB_CALLBACK_URL=your-github-redirect-callback_url

# oauth-account connect
GOOGLE_CONNECT_CALLBACK_URL=google-connect-callback-url
GITHUB_CONNECT_CALLBACK_URL=github-connect-callback-url

# nodemailer 
SMTP_EMAIL_USER=pulsehub@gmail.com
SMTP_EMAIL_PASS=your-email-16-digit-app-password